#!/usr/bin/env bash
# Runs Yousuf's Codex as a board listener. Blocks (free) until a post appears, and only
# calls Codex when the new posts are addressed to Codex. Ctrl+C to stop.
#   tools/codex-loop            # poll every 60s
#   INTERVAL=30 tools/codex-loop
# Codex shares the yousuf-shahzad GitHub login with Claude, and tools/board hides posts from
# your own login and keeps one read cursor per checkout. So the loop uses a private copy of
# tools/board (own cursor, in .codex-state/) with a fake BOARD_LOGIN, so it sees Claude's posts.
# Codex can edit and run commands; additional permissions go through automatic review.
set -uo pipefail
cd "$(dirname "$0")/.."
OWNER="${OWNER:-Yousuf}"; ME="${OWNER}'s Codex"
INTERVAL="${INTERVAL:-30}"
export BOARD_LOGIN="${BOARD_LOGIN:-yousuf-shahzad-codex}"
export BOARD_REPO="${BOARD_REPO:-$(gh repo view --json nameWithOwner -q .nameWithOwner)}"

mkdir -p .codex-state/tools && cp tools/board .codex-state/tools/board
[ -d .codex-state/.git ] || git init -q .codex-state   # own ROOT, so own .board cursor
bd() { (cd .codex-state && tools/board "$@"); }

mkdir .codex-state/loop.lock 2>/dev/null || { echo "Codex listener already running (or stale .codex-state/loop.lock)." >&2; exit 1; }
trap 'rmdir .codex-state/loop.lock' EXIT
trap 'exit 130' INT TERM
PENDING=.codex-state/pending-posts

PROMPT="You are $ME, the edit-capable board worker for this repository. Follow AGENTS.md and read the latest board context before acting. You CAN run commands, edit your assigned files, test, and use the repository's issue/branch/PR workflow. Use Git Bash for tools/board. Work only on current assignments addressed to Codex or @all; respect the lead's reassignments and do not redo completed work. Ignore your own posts and posts addressed only to Claude. Complete authorized work, and post progress/results yourself via tools/board with the [$ME] prefix. If no action or reply is needed, do not post. Your final response is saved locally, not posted automatically. Do not start another listener or change listener state. If automatic review denies a required permission, report the precise blocker on the board."

# Match complete new comments, never an old mention in a last-N context window.
addressed() {
  awk -v me="[$ME]" '
    function emit() {
      text = tolower(body)
      if (index(body, me) != 1 && (text ~ /@all([^a-z0-9_-]|$)/ ||
          text ~ /@yousuf-shahzad[[:space:]]*\(codex\)/ ||
          text ~ /@yousuf-shahzad-codex([^a-z0-9_-]|$)/)) printf "%s%s", header, body
    }
    /^--- @/ { emit(); header = $0 "\n"; body = ""; next }
    { body = body $0 "\n" }
    END { emit() }
  '
}

echo "[$ME] edit-capable listener (every ${INTERVAL}s, automatic approval review). Ctrl+C to stop."
# Process any unread mention on startup; preserve a failed batch across restarts.
if [ ! -s "$PENDING" ]; then
  bd unread > "$PENDING" || { echo "Board unavailable; restart to retry." >&2; exit 1; }
fi
while :; do
  if [ ! -s "$PENDING" ]; then
    bd wait --interval "$INTERVAL" > "$PENDING" || { sleep "$INTERVAL"; continue; }
  fi
  NEW="$(cat "$PENDING")"
  MINE="$(printf '%s\n' "$NEW" | addressed)"
  if [ -z "$MINE" ]; then rm -f "$PENDING"; continue; fi
  echo "[$(date +%T)] post for Codex, running codex"
  if printf '%s\n\nNEW BOARD POSTS:\n%s\n' "$PROMPT" "$NEW" | \
      codex exec --approve-for-me -o .codex-state/last-response.txt - \
      > .codex-state/last-run.log 2>&1; then
    rm -f "$PENDING"
    echo "[$(date +%T)] Codex work finished; waiting for mentions"
  else
    echo "[$(date +%T)] Codex failed; see .codex-state/last-run.log; retrying in ${INTERVAL}s" >&2
    sleep "$INTERVAL"
  fi
done
