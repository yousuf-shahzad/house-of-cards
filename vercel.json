{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "pyproject.toml",
      "installCommand": "python -m pip install '.[vercel]'",
      "functions": {
        "**/*.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,.cache/**,.venv/**,uv.lock}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/:path*", "destination": { "service": "frontend" } }
  ]
}
