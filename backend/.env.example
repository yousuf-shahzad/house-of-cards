# Copy to .env (gitignored) or export in your shell. No secrets are required.
# Quote any value that contains spaces: uv run --env-file stops loading at the first unparsable line.
# Where fetched source files and normalised ETFs are cached (default: backend/.cache).
HOC_CACHE_DIR=
# 1 = never touch the network; serve the cache (any age) or fail.
HOC_OFFLINE=0
# Source fallback order, comma separated: tickerinside,ishares,sec_nport
HOC_SOURCE_ORDER=tickerinside,ishares,sec_nport
# Identifies this app to data providers.
HOC_USER_AGENT="HouseOfCards-PoC/0.1 (hackathon prototype)"
# SEC EDGAR requires a contact in the User-Agent, e.g. "Your Name you@example.com". Needed for sec_nport.
HOC_SEC_CONTACT=
# Optional OpenFIGI API key (keyless works at a lower rate limit). Never commit a real key.
HOC_OPENFIGI_KEY=
# Comma-separated browser origins allowed by CORS.
HOC_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# --- v2 AI dependency analysis (all optional; without a key the app shows cached results) ---
# Gemini API key (hackathon event key). SECRET: set in your shell only, never commit it.
GEMINI_API_KEY=
# Model for the per-company extraction sub-agents, and for the orchestrator.
HOC_GEMINI_EXTRACTOR_MODEL=gemini-3.8-flash
HOC_GEMINI_ORCHESTRATOR_MODEL=gemini-4-argon
# How many of the largest company exposures "Find dependencies" analyses (1-30).
HOC_DEPS_TOP_N=15
# Other companies' filings searched per company for reverse links (0 = off).
HOC_DEPS_REVERSE_LIMIT=3
# Note: fetching 10-K/20-F filings also needs HOC_SEC_CONTACT (above).
