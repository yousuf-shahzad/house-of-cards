  "info": {
    "description": "ETF look-through analysis on real holdings. Weights are fractions of 1.",
    "title": "House of Cards API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/analysis": {
      "post": {
        "operationId": "analysis_api_analysis_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortfolioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "VALIDATION_ERROR, ALLOCATION_SUM_INVALID, DUPLICATE_TICKER, TOO_MANY_ETFS, UNKNOWN_TICKER"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "SOURCES_UNAVAILABLE"
          }
        },
        "summary": "Analysis"
      }
    },
    "/api/etfs/{ticker}": {
      "get": {
        "operationId": "get_etf_api_etfs__ticker__get",
        "parameters": [
          {
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9.\\-]{1,12}$",
              "title": "Ticker",
              "type": "string"
            }
          },
          {
            "description": "include normalised holdings",
            "in": "query",
            "name": "holdings",
            "required": false,
            "schema": {
              "default": false,
              "description": "include normalised holdings",
              "title": "Holdings",
              "type": "boolean"
            }
          },
          {
            "description": "use only this source",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "tickerinside",
                    "sec_nport",
                    "ishares",
                    "fake"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "use only this source",
              "title": "Source"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EtfSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ETF_NOT_FOUND"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "SOURCES_UNAVAILABLE"
          }
        },
        "summary": "Get Etf"
      }
    },
    "/api/examples": {
      "get": {
        "operationId": "examples_api_examples_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamplesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Examples"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
